# ---- Magenta Agents backend ----------------------------------------------
# All variables are optional; the defaults work for local development.

# Where the SQLite database, workspaces and the auto-generated secret live.
# MAGENTA_DATA_DIR=./data

# Explicit DB url (overrides MAGENTA_DATA_DIR derived path)
# MAGENTA_DATABASE_URL=sqlite+aiosqlite:///./data/magenta.db

# Key used to encrypt stored API keys (any string -> sha256 -> Fernet key).
# If unset, a key file is generated at <data_dir>/secret.key with mode 0600.
# MAGENTA_SECRET_KEY=change-me-in-production

# Root directory for agent workspaces (defaults to <data_dir>/workspaces)
# MAGENTA_WORKSPACE_DIR=./data/workspaces

# Comma separated list, or * for any origin
# MAGENTA_CORS_ORIGINS=http://localhost:5173

# Hard limit for a single agent turn
# MAGENTA_RUN_TIMEOUT_SECONDS=3600

# ---- Adapter credentials --------------------------------------------------
# These follow each CLI tool's own convention and are only read when you leave
# the API key field empty in the UI ("ambient credentials").
# ANTHROPIC_BASE_URL=...      ANTHROPIC_AUTH_TOKEN=...
# OPENAI_BASE_URL=...         OPENAI_API_KEY=...
# GOOGLE_GEMINI_BASE_URL=...  GEMINI_API_KEY=...
# DEEPSEEK_BASE_URL=...       DEEPSEEK_API_KEY=...
